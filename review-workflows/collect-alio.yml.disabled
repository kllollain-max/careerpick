# Review only; no active schedule, source commit or deployment.
name: Review ALIO collection
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  collect:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python scripts/collect_alio.py
        env:
          ALIO_KEY: ${{ secrets.ALIO_KEY }}
      - uses: actions/upload-artifact@v4
        with:
          name: alio-review-candidate
          path: |
            alio.json
            alio-detail.json
